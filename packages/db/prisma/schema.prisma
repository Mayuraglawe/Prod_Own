// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Represents a Tenant (Workspace / Organization).
/// The primary boundary for data isolation (Row Level Security target).
model Tenant {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  users      User[]
  sources    Source[]
  jobs       FingerprintJob[]
  alerts     AlertEvent[]
  payments   PaymentEvent[]
  events     Event[]
  issues     Issue[]

  @@index([slug])
}

/// Represents a User account associated with a specific Tenant.
model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Represents an external ingest source producing errors (e.g., API servers, Frontends).
model Source {
  id         String          @id @default(cuid())
  tenantId   String
  externalId String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs       FingerprintJob[]
  events     Event[]
  issues     Issue[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

/// Represents a background job queued to generate deduplicated error groupings (fingerprints).
model FingerprintJob {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  status      String   @default("queued")
  fingerprint String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([sourceId])
}

/// Represents an alert incident event pushed to channels like Slack or n8n.
model AlertEvent {
  id         String   @id @default(cuid())
  tenantId   String
  channel    String
  severity   String   @default("info")
  title      String
  message    String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
}

/// Represents a billing hook notification event tracked from Razorpay.
model PaymentEvent {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String
  providerEvent String
  payload       Json
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, provider])
}

// RLS note:
// Apply row-level security in Postgres migrations using tenant_id scoped policies.
// Prisma defines the multi-tenant data model, but policy enforcement lives in SQL.

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Represents a grouped collection of identical errors.
model Issue {
  id          String      @id @default(cuid())
  tenantId    String
  sourceId    String
  fingerprint String
  status      IssueStatus @default(OPEN)
  title       String?
  firstSeen   DateTime    @default(now())
  lastSeen    DateTime    @default(now())
  eventCount  Int         @default(0)
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  events      Event[]

  // A fingerprint is unique within a specific project/source
  @@unique([sourceId, fingerprint])
  @@index([tenantId, status])
  @@index([lastSeen])
}

/// Represents a raw error event received from an external source.
model Event {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  issueId     String?
  content     String
  metadata    Json?
  environment String?
  release     String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@index([issueId, createdAt])
}
