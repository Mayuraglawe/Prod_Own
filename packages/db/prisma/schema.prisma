// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Represents a Tenant (Workspace / Organization).
/// The primary boundary for data isolation (Row Level Security target).
model Tenant {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  users      User[]
  sources    Source[]
  jobs       FingerprintJob[]
  alerts     AlertEvent[]
  alertConfigs AlertConfig[]
  payments   PaymentEvent[]
  events     Event[]
  issues     Issue[]

  @@index([slug])
}

/// Represents a User account.
model User {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("member")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts      Account[]
  sessions      Session[]

  @@index([tenantId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Represents an external ingest source producing errors (e.g., API servers, Frontends).
model Source {
  id           String          @id @default(cuid())
  tenantId     String
  externalId   String
  name         String
  /// SHA-256 hash of the source's ingest API key. Nullable for sources created before key auth was added.
  apiKeyHash   String?         @unique
  /// Short display prefix of the API key (first 7 chars of the plaintext key, e.g. "po_live").
  /// Safe to display in the UI — does NOT reveal the full key.
  apiKeyPrefix String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs         FingerprintJob[]
  events       Event[]
  issues       Issue[]
  alerts       AlertConfig[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

/// Represents a configuration for dispatching alert webhooks per project/source.
model AlertConfig {
  id         String   @id @default(cuid())
  tenantId   String
  sourceId   String
  channel    String   @default("webhook") // e.g. "webhook", "slack", "n8n"
  webhookUrl String
  events     String[] // e.g. ["new_issue", "reopened"]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
}

/// Represents a background job queued to generate deduplicated error groupings (fingerprints).
model FingerprintJob {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  status      String   @default("queued")
  fingerprint String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([sourceId])
}

/// Represents an alert incident event pushed to channels like Slack or n8n.
model AlertEvent {
  id         String   @id @default(cuid())
  tenantId   String
  channel    String
  severity   String   @default("info")
  title      String
  message    String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
}

/// Represents a billing hook notification event tracked from Razorpay.
model PaymentEvent {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String
  providerEvent String
  payload       Json
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, provider])
}

// RLS note:
// Apply row-level security in Postgres migrations using tenant_id scoped policies.
// Prisma defines the multi-tenant data model, but policy enforcement lives in SQL.

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Represents a grouped collection of identical errors.
model Issue {
  id          String      @id @default(cuid())
  tenantId    String
  sourceId    String
  fingerprint String
  status      IssueStatus @default(OPEN)
  title       String?
  firstSeen   DateTime    @default(now())
  lastSeen    DateTime    @default(now())
  eventCount  Int         @default(0)
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  events      Event[]

  // A fingerprint is unique within a specific project/source
  @@unique([sourceId, fingerprint])
  @@index([tenantId, status])
  @@index([lastSeen])
}

/// Represents a raw error event received from an external source.
model Event {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  issueId     String?
  content     String
  metadata    Json?
  environment String?
  release     String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@index([issueId, createdAt])
}
