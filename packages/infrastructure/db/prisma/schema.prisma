// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Represents a Tenant (Workspace / Organization).
/// The primary boundary for data isolation (Row Level Security target).
model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String

  /// Whether this tenant has been suspended by a Super Admin.
  suspended       Boolean  @default(false)
  /// Timestamp of when the tenant was last suspended.
  suspendedAt     DateTime?
  /// Optional reason recorded by the Super Admin when suspending.
  suspendedReason String?

  /// The current billing plan tier (e.g. "STARTUP", "BUSINESS", "ENTERPRISE").
  planTier        String   @default("STARTUP")
  /// A manual override for monthly event quota. If null, defaults to plan's limits.
  customEventQuota Int?
  /// A manual override for data retention days. If null, defaults to plan's limits.
  customRetentionDays Int?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  sources      Source[]
  jobs         FingerprintJob[]
  alerts       AlertEvent[]
  alertConfigs AlertConfig[]
  payments     PaymentEvent[]
  events       Event[]
  issues       Issue[]
  tracker      TimeTracker?
  auditLogs    AuditLog[]

  @@index([slug])
  @@index([suspended])
}

/// Represents a User account.
model User {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("ADMIN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships WorkspaceMember[]
  accounts    Account[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@index([tenantId])
}

/// Join table for user workspace memberships and role permissions (SUPER_ADMIN / ADMIN / EMPLOYEE).
model WorkspaceMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("ADMIN") // "SUPER_ADMIN" | "ADMIN" | "EMPLOYEE"
  status    String   @default("PENDING") // "PENDING" | "ACTIVE"
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

/// Pending email invitation to join a workspace project.
model WorkspaceInvite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String   @default("ADMIN") // "SUPER_ADMIN" | "ADMIN" | "EMPLOYEE"
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Represents an external ingest source producing errors (e.g., API servers, Frontends).
model Source {
  id           String   @id @default(cuid())
  tenantId     String
  externalId   String
  name         String
  /// SHA-256 hash of the source's ingest API key.
  apiKeyHash   String?  @unique
  /// Short display prefix of the API key (first 7 chars).
  apiKeyPrefix String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs   FingerprintJob[]
  events Event[]
  issues Issue[]
  alerts AlertConfig[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

/// Represents a configuration for dispatching alert webhooks per project/source.
model AlertConfig {
  id         String   @id @default(cuid())
  tenantId   String
  sourceId   String
  channel    String   @default("webhook") // e.g. "webhook", "slack"
  webhookUrl String
  events     String[] // e.g. ["new_issue", "reopened"]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
}

/// Represents a background job queued to generate deduplicated error groupings (fingerprints).
model FingerprintJob {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  status      String   @default("queued")
  fingerprint String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([sourceId])
}

/// Represents an alert incident event pushed to channels like Slack.
model AlertEvent {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String
  severity  String   @default("info")
  title     String
  message   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
}

/// Represents a billing hook notification event tracked from Razorpay.
model PaymentEvent {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String
  providerEvent String
  payload       Json
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, provider])
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Represents a grouped collection of identical errors.
model Issue {
  id          String      @id @default(cuid())
  tenantId    String
  sourceId    String
  fingerprint String
  status      IssueStatus @default(OPEN)
  title       String?
  firstSeen   DateTime    @default(now())
  lastSeen    DateTime    @default(now())
  eventCount  Int         @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([sourceId, fingerprint])
  @@index([tenantId, status])
  @@index([lastSeen])
}

/// Represents a raw error event received from an external source.
model Event {
  id          String   @id @default(cuid())
  tenantId    String
  sourceId    String
  issueId     String?
  content     String
  metadata    Json?
  environment String?
  release     String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  issue  Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@index([issueId, createdAt])
}

/// Persisted Time Tracker state per workspace (RUNNING, PAUSED, STOPPED).
model TimeTracker {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  status         String    @default("STOPPED") // "RUNNING" | "PAUSED" | "STOPPED"
  elapsedSeconds Int       @default(0)
  lastStartedAt  DateTime?
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Immutable audit trail of every privileged action performed by a Super Admin.
/// Written on every suspend, unsuspend, role change, tenant delete, or member removal.
model AuditLog {
  id     String @id @default(cuid())
  /// The Super Admin user who performed the action.
  actorId  String
  /// Optional target tenant affected by the action.
  tenantId String?
  /// Machine-readable action identifier.
  /// Examples: "tenant.suspend" | "tenant.unsuspend" | "tenant.delete"
  ///           "member.role_changed" | "member.removed"
  action   String
  /// Human-readable description of what happened.
  detail   String
  /// Serialised JSON snapshot of relevant payload for forensics.
  payload  Json?
  createdAt DateTime @default(now())

  actor  User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}
